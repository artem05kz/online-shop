# Образец настроек для docker compose. Скопируйте в файл .env рядом и впишите значения.
# Файл .env в git не попадает: в нём пароли и токены.

# Пароль базы PostgreSQL. Придумайте длинный, вводить его руками не придётся.
POSTGRES_PASSWORD=

# Адрес сайта. На сервере домен, например shop.kz: Caddy сам получит сертификат HTTPS.
# На своём компьютере оставьте :80, тогда сайт откроется по http://localhost.
SITE_ADDRESS=:80

# Порты снаружи. Если 80 на компьютере занят, поставьте другой, например 8088.
HTTP_PORT=80
HTTPS_PORT=443

# Токен бота Telegram от @BotFather. Пусто: бот выключен.
TELEGRAM_BOT_TOKEN=

# Ключ 2ГИС для карт. Пусто: карты OpenStreetMap.
TWOGIS_API_KEY=

# Пароль шифрования резервных копий. Сохраните его ещё где-нибудь кроме этого файла (менеджер паролей):
# если сервер пропадёт вместе с .env, без пароля копии не открыть.
BACKUP_PASSWORD=

# Резервные копии: в котором часу (по Актау) и сколько дней хранить.
BACKUP_HOUR=3
KEEP_DAYS=14
