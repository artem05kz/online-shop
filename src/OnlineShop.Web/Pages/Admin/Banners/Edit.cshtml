@page "/admin/banners/{id:int}"
@model OnlineShop.Web.Pages.Admin.Banners.EditModel
@{
    ViewData["Title"] = Model.Id is null ? "Новый баннер" : "Баннер";
    ViewData["AdminSection"] = "banners";
}
@*
    Баннер (25.11.2026). Баннер — готовая картинка во весь первый экран главной, надписи нарисованы на ней.
    Сверху большое поле в форме первого экрана: сюда перетаскивают картинку, и она сразу видна так, как будет
    на сайте (с пунктиром «здесь точки и стрелки»). Ниже — название, ссылка и когда показывать.
*@
<div class="admin-head">
    <h1>@(Model.Id is null ? "Новый баннер" : string.IsNullOrEmpty(Model.Input.Title) ? $"Баннер №{Model.Id}" : Model.Input.Title)</h1>
    <a class="btn btn-ghost" asp-page="Index">@Icons.Get("arrow-left", 18) Все баннеры</a>
</div>

<form method="post" enctype="multipart/form-data" class="bn-form">
    <section class="admin-box">
        <h3>Картинка</h3>
        <p class="hint">
            Размер <b>@BannerShape.RecommendedWidth × @BannerShape.RecommendedHeight</b> — это первый экран главной (1200 × 440) в два раза крупнее, чтобы было чётко.
            Все надписи и кнопки рисуйте прямо на картинке. JPG, PNG или WEBP.
        </p>
        <label class="fx-drop bn-drop@(Model.CurrentImage is not null ? " has-file" : "")" data-banner-drop
               data-ratio="@BannerShape.Ratio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
               data-min="@BannerShape.MinWidth" data-w="@BannerShape.RecommendedWidth" data-h="@BannerShape.RecommendedHeight">
            <img class="bn-drop-img" src="@(Model.CurrentImage is not null ? Media.Url(Model.CurrentImage) : "")" alt="" @(Model.CurrentImage is null ? "hidden" : "")>
            <span class="bn-safe" aria-hidden="true"><span>здесь точки и стрелки</span></span>
            <span class="bn-drop-empty">
                <span class="fx-drop-icon">@Icons.Get("image", 24)</span>
                <b>Перетащите картинку сюда</b>
                <small>или нажмите, чтобы выбрать файл</small>
            </span>
            <span class="bn-drop-change">@Icons.Get("upload", 16) Заменить картинку</span>
            <input class="visually-hidden" type="file" asp-for="Image" accept="image/jpeg,image/png,image/gif,image/webp">
        </label>
        <p class="bn-drop-note" id="banner-note" data-start="@Model.CurrentImageNote">@(Model.CurrentImageNote.Length > 0 ? Model.CurrentImageNote : "Картинка не выбрана.")</p>
        <span class="errorlist" asp-validation-for="Image"></span>
    </section>

    <div class="bn-form-grid">
        <section class="admin-box">
            <h3>Название и ссылка</h3>
            <div class="form-row">
                <label asp-for="Input.Title"></label>
                <input class="field" asp-for="Input.Title" placeholder="Например: Скидки на воски, декабрь">
                <span class="help">Покупатель его не видит: оно для списка баннеров и для программ, которые читают сайт вслух.</span>
                <span class="errorlist" asp-validation-for="Input.Title"></span>
            </div>
            <div class="form-row">
                <label asp-for="Input.LinkUrl"></label>
                <input class="field" asp-for="Input.LinkUrl" placeholder="/catalog/ifoam/воски">
                <span class="help">Куда попадёт покупатель, если нажмёт на баннер. Пусто — баннер просто картинка.</span>
                <span class="errorlist" asp-validation-for="Input.LinkUrl"></span>
            </div>
        </section>

        <section class="admin-box">
            <h3>Когда показывать</h3>
            <div class="form-grid">
                <div class="form-row">
                    <label asp-for="Input.StartsAt"></label>
                    <input class="field" asp-for="Input.StartsAt" type="datetime-local">
                    <span class="help">Пусто — сразу.</span>
                </div>
                <div class="form-row">
                    <label asp-for="Input.EndsAt"></label>
                    <input class="field" asp-for="Input.EndsAt" type="datetime-local">
                    <span class="help">Пусто — без срока.</span>
                    <span class="errorlist" asp-validation-for="Input.EndsAt"></span>
                </div>
            </div>
            <label class="pe-switch-row fe-switch">
                <span class="vl-switch"><input asp-for="Input.IsActive"><span aria-hidden="true"></span></span>
                <span>Показывать на сайте</span>
            </label>
            <p class="help">Время — по Актау. Когда срок закончится, баннер сам пропадёт с сайта, а в списке будет во вкладке «Закончились».</p>
        </section>
    </div>

    <div class="savebar">
        <button class="btn" type="submit">@Icons.Get("check") Сохранить</button>
        <a class="btn btn-ghost" href="/admin/banners">Отмена</a>
    </div>
</form>

@if (Model.Id is not null)
{
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id" class="bn-delete" data-confirm="Удалить баннер насовсем? Картинка тоже удалится.">
        <button class="btn btn-sm wash-second is-cancel fe-delete" type="submit">@Icons.Get("trash", 16) Удалить баннер</button>
    </form>
}

@section Scripts {
    <script src="~/js/admin_banner_edit.js" asp-append-version="true"></script>
}
