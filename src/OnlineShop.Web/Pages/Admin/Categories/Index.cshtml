@page "/admin/categories"
@model OnlineShop.Web.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "Бренды и категории";
    ViewData["AdminSection"] = "categories";
}
<div class="admin-head">
    <h1>Бренды и категории</h1>
    <a class="btn" href="/admin/brands/add">@Icons.Get("plus") Новый бренд</a>
</div>

@if (Model.Tree.Brands.Count == 0)
{
    <div class="admin-box">Брендов пока нет. Они появятся сами после загрузки товаров из 1С, или добавьте бренд кнопкой выше.</div>
}

<ul class="tree">
    @foreach (var brand in Model.Tree.Brands)
    {
        var b = brand.Brand;
        <li class="tree-brand" id="brand-@b.Id">
            <div class="tree-row">
                <span class="t-name">
                    @Icons.Get("layers", 22)
                    @b.Name
                    @if (!b.IsActive)
                    {
                        <span class="pill off">@Icons.Get("eye-off", 16) скрыт</span>
                    }
                </span>
                <span class="t-count">@brand.TotalProducts @Plural.Products(brand.TotalProducts)</span>
                <span class="t-actions">
                    <form method="post" asp-page-handler="Move" asp-route-kind="brand" asp-route-id="@b.Id" asp-route-direction="-1">
                        <button class="btn btn-ghost btn-sm btn-icon" type="submit" title="Выше" aria-label="Переместить бренд выше">@Icons.Get("arrow-up")</button>
                    </form>
                    <form method="post" asp-page-handler="Move" asp-route-kind="brand" asp-route-id="@b.Id" asp-route-direction="1">
                        <button class="btn btn-ghost btn-sm btn-icon" type="submit" title="Ниже" aria-label="Переместить бренд ниже">@Icons.Get("arrow-down")</button>
                    </form>
                    <a class="btn btn-ghost btn-sm" href="/admin/categories/add?brand=@b.Id">@Icons.Get("plus", 18) Категория</a>
                    <a class="btn btn-ghost btn-sm" href="/admin/brands/@b.Id">@Icons.Get("pencil", 18) Изменить</a>
                </span>
            </div>
            @if (brand.Roots.Count > 0)
            {
                <ul>
                    @foreach (var node in brand.Roots)
                    {
                        <partial name="_Node" model="node" />
                    }
                </ul>
            }
            else
            {
                <p class="admin-count" style="margin:6px 0 0 26px;">Категорий нет.</p>
            }
        </li>
    }
</ul>
