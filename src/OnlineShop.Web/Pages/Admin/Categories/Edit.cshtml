@page "/admin/categories/{id:int}"
@model OnlineShop.Web.Pages.Admin.Categories.EditModel
@{
    ViewData["Title"] = Model.Id is null ? "Новая категория" : "Категория";
    ViewData["AdminSection"] = "categories";
}
<div class="admin-head">
    <h1>@(Model.Id is null ? "Новая категория" : Model.Input.Name)</h1>
    <a class="btn btn-ghost" asp-page="Index">К списку</a>
</div>

<form method="post" class="admin-box form-narrow">
    <div class="form-row">
        <label asp-for="Input.BrandId"></label>
        <select class="select" asp-for="Input.BrandId">
            <option value="">Выберите бренд</option>
            @foreach (var brand in Model.Brands)
            {
                <option value="@brand.Id">@brand.Name</option>
            }
        </select>
        <span class="errorlist" asp-validation-for="Input.BrandId"></span>
    </div>
    <div class="form-row">
        <label asp-for="Input.ParentId"></label>
        @* В Django пустой вариант был строкой из дефисов, она читалась как заглушка, поэтому «Нет». *@
        <select class="select" asp-for="Input.ParentId">
            <option value="">Нет</option>
            @foreach (var parent in Model.Parents)
            {
                <option value="@parent.Id">@parent.Brand.Name / @parent.Name</option>
            }
        </select>
        <span class="errorlist" asp-validation-for="Input.ParentId"></span>
    </div>
    <div class="form-row">
        <label asp-for="Input.Name"></label>
        <input class="field" asp-for="Input.Name">
        <span class="errorlist" asp-validation-for="Input.Name"></span>
    </div>
    <div class="form-row">
        <label asp-for="Input.Slug"></label>
        <input class="field" asp-for="Input.Slug">
        <span class="help">Часть адреса страницы. Оставьте пустым, и он заполнится из названия.</span>
        <span class="errorlist" asp-validation-for="Input.Slug"></span>
    </div>
    <div class="form-row">
        <label asp-for="Input.SortOrder"></label>
        <input class="field" asp-for="Input.SortOrder" type="number" min="0">
        <span class="help">Категории выводятся по этому числу от меньшего к большему.</span>
        <span class="errorlist" asp-validation-for="Input.SortOrder"></span>
    </div>
    <label class="check" style="margin-bottom:16px;">
        <input asp-for="Input.IsActive">
        <span>Показывать на сайте</span>
    </label>
    <div class="admin-actions">
        <button class="btn" type="submit">Сохранить</button>
    </div>
</form>

@if (Model.Id is not null)
{
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id" onsubmit="return confirm('Удалить категорию вместе с вложенными?');">
        <button class="btn btn-danger btn-sm" type="submit">Удалить категорию</button>
    </form>
}
