@page "/admin/stores/{id:int}"
@model OnlineShop.Web.Pages.Admin.Stores.EditModel
@{
    ViewData["Title"] = Model.Id is null ? "Новая точка" : "Адрес магазина";
    ViewData["AdminSection"] = "stores";
}
<div class="admin-head">
    <h1>@(Model.Id is null ? "Новая точка" : Model.Input.Address)</h1>
    <a class="btn btn-ghost" asp-page="Index">К списку</a>
</div>

<form method="post" style="max-width:760px;">
    <div class="admin-box">
        <h3>Адрес точки</h3>
        <p class="hint">Адрес пишите так, как его должен увидеть покупатель, одной строкой.</p>
        <div class="form-row">
            <label asp-for="Input.Address"></label>
            <input class="field" asp-for="Input.Address" placeholder="г. Актау, 21 микрорайон, рынок «Алем», бутик №74">
            <span class="errorlist" asp-validation-for="Input.Address"></span>
        </div>
        <div class="form-grid">
            <div class="form-row">
                <label asp-for="Input.City"></label>
                <input class="field" asp-for="Input.City">
                <span class="errorlist" asp-validation-for="Input.City"></span>
            </div>
            <div class="form-row">
                <label asp-for="Input.Kind"></label>
                <select class="select" asp-for="Input.Kind">
                    @foreach (var kind in Enum.GetValues<StoreKind>())
                    {
                        <option value="@kind">@kind.Label()</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="admin-box">
        <h3>Режим работы и связь</h3>
        <div class="form-grid">
            <div class="form-row">
                <label asp-for="Input.WorkingHours"></label>
                <input class="field" asp-for="Input.WorkingHours" placeholder="Пн-Сб, 9:00-18:00">
                <span class="errorlist" asp-validation-for="Input.WorkingHours"></span>
            </div>
            <div class="form-row">
                <label asp-for="Input.LunchHours"></label>
                <input class="field" asp-for="Input.LunchHours" placeholder="с 13:00 до 14:00">
                <span class="help">Оставьте пустым, если обеда нет.</span>
                <span class="errorlist" asp-validation-for="Input.LunchHours"></span>
            </div>
            <div class="form-row">
                <label asp-for="Input.Phone"></label>
                <input class="field" asp-for="Input.Phone">
                <span class="errorlist" asp-validation-for="Input.Phone"></span>
            </div>
        </div>
    </div>

    <div class="admin-box">
        <h3>Показ на сайте</h3>
        <div class="form-row form-narrow">
            <label asp-for="Input.SortOrder"></label>
            <input class="field" asp-for="Input.SortOrder" type="number" min="0">
            <span class="help">Точки выводятся по этому числу от меньшего к большему.</span>
        </div>
        <label class="check">
            <input asp-for="Input.IsActive">
            <span>Показывать на сайте</span>
        </label>
    </div>

    <div class="admin-box">
        <h3>Точка на карте</h3>
        <p class="hint">Нажмите на карту там, где находится магазин. По этой точке покупатель построит маршрут в 2ГИС.</p>
        <div id="store-map" class="map-picker" data-map-picker data-provider="@(Model.MapKey.Length > 0 ? "twogis" : "osm")" data-key="@Model.MapKey"
             data-lat="Input_Latitude" data-lng="Input_Longitude" data-hint="store-map-hint"></div>
        <p class="admin-count" id="store-map-hint" style="margin:8px 0 0;">Метка не поставлена.</p>
        <span class="errorlist" asp-validation-for="Input.Latitude"></span>
        <span class="errorlist" asp-validation-for="Input.Longitude"></span>
        <input type="hidden" asp-for="Input.Latitude">
        <input type="hidden" asp-for="Input.Longitude">
        <details style="margin-top:14px;">
            <summary class="admin-count" style="cursor:pointer;">Своя ссылка «Как добраться» (необязательно)</summary>
            <div class="form-row" style="margin-top:10px;">
                <input class="field" asp-for="Input.MapUrl" placeholder="https://2gis.kz/...">
                <span class="help">Если указать, кнопка поведёт по ней, а не по точке на карте. Например, на карточку магазина в 2ГИС.</span>
                <span class="errorlist" asp-validation-for="Input.MapUrl"></span>
            </div>
        </details>
    </div>

    <div class="savebar">
        <button class="btn" type="submit">@Icons.Get("check") Сохранить</button>
        <a class="btn btn-ghost" href="/admin/stores">Отмена</a>
    </div>
</form>

@if (Model.Id is not null)
{
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id" style="margin-top:24px;" onsubmit="return confirm('Удалить эту точку?');">
        <button class="btn btn-danger btn-sm" type="submit">Удалить точку</button>
    </form>
}

@section Scripts {
    <partial name="_MapScripts" model="Model.MapKey" />
}
