@page "/admin/import/confirm"
@model OnlineShop.Web.Pages.Admin.Import.ConfirmModel
@{
    ViewData["Title"] = "Загрузка завершена";
    ViewData["AdminSection"] = "import";
    var s = Model.Stats;
}
<div class="admin-head"><h1>Загрузка завершена</h1></div>
<ol class="im-steps" aria-label="Шаги">
    <li class="is-done"><b>1</b>Выберите файлы</li>
    <li class="is-done"><b>2</b>Проверьте, что получится</li>
    <li class="is-now"><b>3</b>Готово: каталог обновлён</li>
</ol>
<ul class="im-stats">
    <li class="@(s.ProductsCreated > 0 ? "is-new" : "")"><b>@s.ProductsCreated</b><span>новых товаров</span></li>
    <li><b>@s.ProductsUpdated</b><span>обновлено товаров</span></li>
    <li class="@(s.VariantsCreated > 0 ? "is-new" : "")"><b>@s.VariantsCreated</b><span>новых артикулов</span></li>
    <li><b>@s.VariantsUpdated</b><span>обновлено артикулов</span></li>
    <li><b>@s.StockMatched</b><span>остатков сопоставлено</span></li>
    <li><b>@s.ImagesAdded</b><span>добавлено фото</span></li>
    <li><b>@s.Brands</b><span>новых брендов</span></li>
    <li><b>@s.Categories</b><span>новых категорий</span></li>
</ul>

@if (s.StockUnmatched.Count > 0)
{
    <ul class="warnings">
        <li>Артикулов из остатков без пары в каталоге: @s.StockUnmatched.Count. Это нормально, если товар из этой
            выгрузки ещё не загружался через прайс-лист.
            <details style="margin-top:6px;"><summary>Показать артикулы</summary>@string.Join(", ", s.StockUnmatched)</details>
        </li>
    </ul>
}

@if (s.VariantsCreated > 0)
{
    <p class="vl-hint im-warn">@Icons.Get("alert", 16) <span>Новые артикулы пришли без розничной цены: из 1С приходит только оптовая. Пока цены нет, на сайте
        у них «цена уточняется» и купить их нельзя. Цены можно проставить в разделе <a href="/admin/variants">«Цены и остатки»</a>.</span></p>
}

<div class="im-foot">
    <a class="btn btn-ghost" href="/admin/import">@Icons.Get("upload", 18) Загрузить ещё файл</a>
    <a class="btn" href="/admin/products">@Icons.Get("package", 18) К товарам</a>
</div>
