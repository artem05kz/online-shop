@page "/admin/brands/{id:int}"
@model OnlineShop.Web.Pages.Admin.Brands.EditModel
@{
    ViewData["Title"] = Model.Id is null ? "Новый бренд" : "Бренд";
    ViewData["AdminSection"] = "categories";
}
<div class="admin-head">
    <h1>@(Model.Id is null ? "Новый бренд" : Model.Input.Name)</h1>
    <a class="btn btn-ghost" href="/admin/categories">@Icons.Get("arrow-left") Ко всем брендам</a>
</div>

<form method="post">
    <div class="admin-box" style="max-width:720px;">
        <div class="form-row">
            <label asp-for="Input.Name"></label>
            <input class="field" asp-for="Input.Name">
            <span class="errorlist" asp-validation-for="Input.Name"></span>
        </div>
        <label class="pe-switch-row fe-switch">
            <span class="vl-switch"><input asp-for="Input.IsActive"><span aria-hidden="true"></span></span>
            <span>Показывать на сайте</span>
        </label>
        <details style="margin-top:14px;">
            <summary class="admin-count" style="cursor:pointer;">Адрес страницы на сайте</summary>
            <div class="form-row" style="margin-top:10px;">
                <input class="field" asp-for="Input.Slug">
                <span class="help">Заполняется сам из названия, менять не обязательно.</span>
                <span class="errorlist" asp-validation-for="Input.Slug"></span>
            </div>
        </details>
        <input type="hidden" asp-for="Input.SortOrder">
    </div>
    <div class="savebar" style="max-width:720px;">
        <button class="btn" type="submit">@Icons.Get("check") Сохранить</button>
        <a class="btn btn-ghost" href="/admin/categories">Отмена</a>
    </div>
</form>

@if (Model.Node is { } brand)
{
    <h2>Категории бренда</h2>
    <div class="admin-box" style="max-width:720px;">
        @if (brand.Roots.Count > 0)
        {
            <ul class="tree">
                <li class="tree-brand">
                    <div class="tree-row"><span class="t-name">@Icons.Get("layers", 22) @brand.Brand.Name</span>
                        <span class="t-count">@brand.TotalProducts @Plural.Products(brand.TotalProducts)</span></div>
                    <ul>
                        @foreach (var root in brand.Roots)
                        {
                            <partial name="_BrandNode" model="root" />
                        }
                    </ul>
                </li>
            </ul>
        }
        else
        {
            <p style="margin-top:0;">Категорий пока нет.</p>
        }
        <div class="admin-actions">
            <a class="btn btn-ghost" href="/admin/categories/add?brand=@brand.Brand.Id">@Icons.Get("plus") Добавить категорию</a>
        </div>
    </div>

    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id" style="margin-top:28px;"
          data-confirm="Удалить бренд вместе с его категориями?">
        <button class="btn btn-sm wash-second is-cancel fe-delete" type="submit">@Icons.Get("trash", 16) Удалить бренд</button>
    </form>
}
