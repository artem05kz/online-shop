@page "/admin/users"
@model OnlineShop.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Покупатели и доступ";
    ViewData["AdminSection"] = "users";
}
<div class="admin-head"><h1>Покупатели и доступ</h1></div>
<form class="pl-filters" method="get" role="search">
    <input class="field" type="search" name="q" value="@Model.Q" placeholder="Логин, имя или почта" aria-label="Поиск покупателя">
    <button class="btn btn-ghost" type="submit">@Icons.Get("search", 18) Найти</button>
</form>
<p class="vl-hint">@Icons.Get("info", 16) <span>Менеджеры видят эту панель управления. Пароль покупателя здесь не меняется: он сам задаёт его при регистрации.</span></p>

@if (Model.List.Items.Count == 0)
{
    <div class="admin-box o-empty"><p>Никого не нашлось. Проверьте логин или почту.</p></div>
}
else
{
    <ul class="o-list">
        @foreach (var row in Model.List.Items)
        {
            var name = string.IsNullOrEmpty(row.FullName) ? row.UserName : row.FullName;
            <li class="ad-row ad-user@(row.IsManager ? " is-manager" : "")">
                <span class="wc-ava" aria-hidden="true">@name[..1].ToUpperInvariant()</span>
                <div class="ct-main">
                    <b class="ct-title">@name</b>
                    <small>@row.UserName@(string.IsNullOrEmpty(row.Email) ? "" : " · " + row.Email)</small>
                </div>
                <div class="ad-orders">
                    @if (row.Orders > 0)
                    {
                        <a href="/admin/orders?q=@Uri.EscapeDataString(row.UserName)"><b>@row.Orders</b> @Plural.Choose(row.Orders, "заказ", "заказа", "заказов")</a>
                    }
                    else
                    {
                        <span class="muted">заказов нет</span>
                    }
                </div>
                <span class="ad-role">@(row.IsManager ? "Менеджер" : "Покупатель")</span>
                <form method="post" asp-page-handler="ToggleManager" asp-route-id="@row.Id" asp-route-q="@Model.Q"
                      data-confirm="@(row.IsManager ? "Снять доступ в панель?" : "Дать доступ в панель управления?")">
                    <button class="btn btn-sm wash-second@(row.IsManager ? " is-cancel" : "")" type="submit">@(row.IsManager ? "Снять доступ" : "Сделать менеджером")</button>
                </form>
            </li>
        }
    </ul>
}
<partial name="_AdminPager" model="PagerInfo.From(Model.List)" />
