@page "/admin/users"
@model OnlineShop.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Покупатели и доступ";
    ViewData["AdminSection"] = "users";
}
<div class="admin-head">
    <h1>Покупатели и доступ</h1>
</div>
<p class="admin-count">Менеджеры видят панель управления. Пароль покупателя здесь не меняется: он сам задаёт его при регистрации.</p>

<form class="admin-filters" method="get">
    <input class="field" type="search" name="q" value="@Model.Q" placeholder="Логин, имя или почта">
    <button class="btn btn-ghost" type="submit">Найти</button>
</form>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead><tr><th>Логин</th><th>Имя</th><th>Почта</th><th class="num">Заказов</th><th>Менеджер</th><th></th></tr></thead>
        <tbody>
            @foreach (var row in Model.List.Items)
            {
                <tr>
                    <td>@row.UserName</td>
                    <td>@row.FullName</td>
                    <td>@row.Email</td>
                    <td class="num">@if (row.Orders > 0) { <a href="/admin/orders?q=@Uri.EscapeDataString(row.UserName)">@row.Orders</a> } else { <span class="muted">0</span> }</td>
                    <td>@(row.IsManager ? "да" : "")</td>
                    <td>
                        <form method="post" asp-page-handler="ToggleManager" asp-route-id="@row.Id" asp-route-q="@Model.Q"
                              onsubmit="return confirm('@(row.IsManager ? "Снять доступ в панель?" : "Дать доступ в панель управления?")');">
                            <button class="btn btn-ghost btn-sm" type="submit">@(row.IsManager ? "Снять доступ" : "Сделать менеджером")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<partial name="_AdminPager" model="PagerInfo.From(Model.List)" />
