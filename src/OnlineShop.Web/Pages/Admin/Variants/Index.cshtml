@page "/admin/variants"
@model OnlineShop.Web.Pages.Admin.Variants.IndexModel
@{
    ViewData["Title"] = "Цены и остатки";
    ViewData["AdminSection"] = "variants";
}
<div class="admin-head">
    <h1>Цены и остатки</h1>
    <a class="btn btn-ghost" href="/admin/import/stock">@Icons.Get("refresh") Обновить остатки из 1С</a>
</div>

<form class="admin-filters" method="get">
    <input class="field" type="search" name="q" value="@Model.Q" placeholder="Артикул или название товара">
    <select class="select" name="brand" data-autosubmit>
        <option value="">Все бренды</option>
        @foreach (var brand in Model.Brands)
        {
            <option value="@brand.Id" selected="@(Model.Brand == brand.Id)">@brand.Name</option>
        }
    </select>
    <select class="select" name="active" data-autosubmit>
        <option value="">Показ: все</option>
        <option value="1" selected="@(Model.Active == "1")">Показываются</option>
        <option value="0" selected="@(Model.Active == "0")">Скрыты</option>
    </select>
    @if (!string.IsNullOrEmpty(Model.O))
    {
        <input type="hidden" name="o" value="@Model.O">
    }
    <button class="btn" type="submit">@Icons.Get("search") Найти</button>
</form>

<form id="changelist-form" method="post" asp-page-handler="SaveList"
      asp-route-q="@Model.Q" asp-route-brand="@Model.Brand" asp-route-active="@Model.Active" asp-route-o="@Model.O" asp-route-p="@Request.Query["p"]">
    <div class="admin-table-wrap">
        <p class="hint" style="margin:0 0 10px;">«В резерве»: сколько штук заказано на сайте в заказах, которые ещё не выполнены. На сайте можно заказать остаток минус резерв. Когда заказ выполнен или отменён, резерв снимается сам: выполненный заказ к этому времени проведите в 1С.</p>
    <table class="admin-table" id="result_list">
            <thead>
                <tr>
                    <th>@AdminList.SortHeader(Request, "product", "Товар")</th>
                    <th>Фасовка</th>
                    <th>@AdminList.SortHeader(Request, "article", "Артикул")</th>
                    <th>@AdminList.SortHeader(Request, "price", "Розничная цена")</th>
                    <th>@AdminList.SortHeader(Request, "stock", "Остаток")</th>
                    <th title="Заказано на сайте, заказ ещё не выполнен">В резерве</th>
                    <th>На сайте</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Rows.Count; i++)
                {
                    var row = Model.Rows[i];
                    <tr>
                        <td>
                            <input type="hidden" asp-for="Rows[i].Id">
                            <input type="hidden" asp-for="Rows[i].Article">
                            <span class="cell-product">
                                @if (row.ImagePath is not null)
                                {
                                    <img class="thumb" src="@Media.Thumb(row.ImagePath, Media.Small)" alt="" loading="lazy">
                                }
                                <a href="/admin/products/@row.ProductId">@row.ProductName</a>
                            </span>
                        </td>
                        <td><strong>@row.PackLabel</strong></td>
                        <td><a asp-page="Edit" asp-route-id="@row.Id">@row.Article</a></td>
                        <td><input class="field small" asp-for="Rows[i].Price" inputmode="decimal"></td>
                        <td><input class="field tiny" asp-for="Rows[i].StockQty" inputmode="numeric"></td>
                        <td class="num">@(Model.Rows[i].ReservedQty > 0 ? Model.Rows[i].ReservedQty.ToString() : "")</td>
                        <td><input asp-for="Rows[i].IsActive"></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Rows.Count > 0)
    {
        <div class="savebar">
            <button class="btn" type="submit">@Icons.Get("check") Сохранить</button>
            <span class="note">Изменённые строки подсвечиваются зелёным.</span>
        </div>
    }
</form>
<partial name="_AdminPager" model="Model.Pager" />
