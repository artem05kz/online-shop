@page "/admin/products"
@model OnlineShop.Web.Pages.Admin.Products.IndexModel
@{
    ViewData["Title"] = "Товары";
    ViewData["AdminSection"] = "products";
}
<div class="admin-head">
    <h1>Товары</h1>
    <a class="btn btn-ghost" href="/admin/import">@Icons.Get("upload") Загрузить из 1С</a>
    <a class="btn" href="/admin/products/add">@Icons.Get("plus") Новый товар</a>
</div>

<form class="admin-filters" method="get">
    <input class="field" type="search" name="q" value="@Model.Q" placeholder="Название или артикул">
    <select class="select" name="category" onchange="this.form.submit()" aria-label="Категория">
        <option value="">Все категории</option>
        @foreach (var node in Model.Tree.Flatten())
        {
            <option value="@node.Category.Id" selected="@(Model.Category == node.Category.Id)">@Model.Tree.Path(node.Category.Id)</option>
        }
    </select>
    <select class="select" name="o" onchange="this.form.submit()" aria-label="Порядок">
        @foreach (var (value, label) in OnlineShop.Web.Pages.Admin.Products.IndexModel.SortOptions)
        {
            <option value="@value" selected="@((Model.O ?? "name") == value)">@label</option>
        }
    </select>
    @if (!string.IsNullOrEmpty(Model.Filter))
    {
        <input type="hidden" name="filter" value="@Model.Filter">
    }
    <button class="btn" type="submit">@Icons.Get("search") Найти</button>
</form>

<div class="chips">
    @foreach (var show in Model.Shows)
    {
        <a class="chip-link @((Model.Filter ?? "") == show.Value ? "on" : "")"
           href="@QueryStrings.With(Request.Query, "filter", show.Value)">@show.Label <span class="n">@show.Count</span></a>
    }
</div>

@if (Model.List.Items.Count == 0)
{
    <div class="admin-box">Ничего не нашлось. Попробуйте другое название или нажмите «Все».</div>
}

<div class="item-list">
    @foreach (var row in Model.List.Items)
    {
        var product = row.Product;
        var image = product.PrimaryImage;
        <a class="item" href="/admin/products/@product.Id">
            @if (image is not null)
            {
                <img class="thumb" src="@Media.Url(image.ImagePath)" alt="" loading="lazy">
            }
            else
            {
                <span class="thumb empty">нет фото</span>
            }
            <span>
                <span class="name">@product.Name</span>
                <span class="path">@row.Path</span>
                <span class="facts">
                    <span>Фасовки: @string.Join(", ", row.Packs.Select(v => string.IsNullOrEmpty(v.PackLabel) ? v.Article : v.PackLabel))</span>
                </span>
            </span>
            <span class="side">
                <span class="price">
                    @if (row.MinPrice is { } min)
                    {
                        @(row.MaxPrice > min ? $"{Format.Money(min)} - {Format.Money(row.MaxPrice!.Value)}" : Format.Money(min))
                    }
                    else
                    {
                        <span class="pill warn">нет цены</span>
                    }
                </span>
                @if (!product.IsActive)
                {
                    <span class="pill off">@Icons.Get("eye-off", 16) скрыт</span>
                }
                else if (row.InStock)
                {
                    <span class="pill ok">@Icons.Get("check", 16) в наличии</span>
                }
                else
                {
                    <span class="pill bad">нет в наличии</span>
                }
                @if (row.HasUnpriced && row.MinPrice is not null)
                {
                    <span class="pill warn">есть фасовка без цены</span>
                }
            </span>
        </a>
    }
</div>
<partial name="_AdminPager" model="PagerInfo.From(Model.List)" />
