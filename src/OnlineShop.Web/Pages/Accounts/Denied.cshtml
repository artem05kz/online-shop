@page "/accounts/denied"
@{
    ViewData["Title"] = "Нет доступа";
    // Нет доступа (24.11): та же чёрная плашка, что у страниц ошибок. Имя показываем, только если человек вошёл.
    var name = User.Identity?.IsAuthenticated == true ? User.Identity.Name : null;
    var card = (403, "Нет доступа",
        "Панель управления открыта только менеджерам магазина." + (string.IsNullOrEmpty(name) ? "" : $" Вы вошли как «{name}»."),
        false);
}
<partial name="/Views/Catalog/_ErrorCard.cshtml" model="card" />
