@page "/accounts/denied"
@{
    ViewData["Title"] = "Нет доступа";
}
<div class="empty">
    <div class="empty-ico">@Icons.Get("alert", 44)</div>
    <h2>Нет доступа</h2>
    <p>Панель управления открыта только менеджерам магазина. Вы вошли как «@User.Identity?.Name».</p>
    <p style="margin-top:18px;"><a class="btn" asp-controller="Catalog" asp-action="Home">На главную</a></p>
</div>
