@page "/accounts/login"
@model LoginModel
@{
    ViewData["Title"] = "Вход";
}
<div class="panel form-narrow" style="margin:34px auto;">
    <h1>Вход</h1>
    <form method="post" style="margin-top:18px;">
        @if (Model.Error is not null)
        {
            <ul class="messages">
                <li class="message error">@Model.Error</li>
            </ul>
        }
        <input type="hidden" asp-for="ReturnUrl">
        <div class="form-row">
            <label asp-for="Input.UserName"></label>
            <input class="field" asp-for="Input.UserName" autocomplete="username" autofocus>
            <span class="errorlist" asp-validation-for="Input.UserName"></span>
        </div>
        <div class="form-row">
            <label asp-for="Input.Password"></label>
            <input class="field" asp-for="Input.Password" autocomplete="current-password">
            <span class="errorlist" asp-validation-for="Input.Password"></span>
        </div>
        <button class="btn btn-block" type="submit">Войти</button>
    </form>
    <p class="muted" style="margin-top:16px; font-size:.9rem;">
        Нет аккаунта? <a asp-page="Register" asp-route-returnUrl="@Model.ReturnUrl" style="color:var(--green-dark); font-weight:600;">Зарегистрироваться</a>
    </p>
</div>
