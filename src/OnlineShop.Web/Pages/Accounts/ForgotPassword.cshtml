@page "/accounts/forgot-password"
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Забыли пароль";
}
<div class="panel form-narrow" style="margin:34px auto;">
    <h1>Забыли пароль</h1>
    <p class="muted">Укажите почту из аккаунта, мы пришлём на неё код для смены пароля.</p>
    <form method="post" style="margin-top:18px;">
        <div class="form-row">
            <label asp-for="Email"></label>
            <input class="field" asp-for="Email" type="email" autocomplete="email" autofocus>
            <span class="errorlist" asp-validation-for="Email"></span>
        </div>
        <button class="btn btn-block" type="submit">Получить код</button>
    </form>
    <p class="muted" style="margin-top:16px; font-size:.9rem;">
        Не указывали почту или нет к ней доступа? Позвоните в магазин, менеджер поможет.
    </p>
</div>
