@page "/accounts/forgot-password"
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Забыли пароль";
}
<div class="auth">
<div class="auth-card auth-narrow">
    <h1>Забыли пароль</h1>
    <p class="auth-lead">Укажите почту из аккаунта, мы пришлём на неё код для смены пароля.</p>
    <form method="post">
        <div class="form-row">
            <label asp-for="Email"></label>
            <input class="field" asp-for="Email" type="email" autocomplete="email" autofocus>
            <span class="errorlist" asp-validation-for="Email"></span>
        </div>
        <button class="btn btn-block auth-submit" type="submit">Получить код</button>
    </form>
    <p class="auth-switch">
        Не указывали почту или нет к ней доступа? Позвоните в магазин, менеджер поможет.
    </p>
</div>
</div>
