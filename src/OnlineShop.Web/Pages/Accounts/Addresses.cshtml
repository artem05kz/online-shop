@page "/accounts/profile/addresses"
@model AddressesModel
@{
    ViewData["Title"] = "Адреса доставки";
    ViewData["AccountTab"] = "addresses";
}
@* Адреса доставки: карточки (основной первым и с чёрной меткой) и плитка «Добавить адрес». *@
<div class="acc">
<partial name="_AccountTabs" />
<div class="acc-main">
<h1 class="acc-title">Адреса доставки</h1>
<p class="acc-lead">Основной адрес сам подставляется при оформлении заказа.</p>

<div class="addr-grid">
    @foreach (var address in Model.Addresses)
    {
        <article class="co-card addr-card@(address.IsDefault ? " is-default" : "")">
            <div class="addr-top">
                <span class="addr-name">@(string.IsNullOrEmpty(address.Label) ? "Адрес" : address.Label)</span>
                @if (address.IsDefault)
                {
                    <span class="addr-main">Основной</span>
                }
            </div>
            <p class="addr-line">@address.StreetLine</p>
            <p class="addr-sub">@address.City@(address.DetailsLine.Length > 0 ? ", " + address.DetailsLine : "")</p>
            <p class="addr-who">@address.FullName · @address.Phone</p>
            @if (!string.IsNullOrEmpty(address.Comment))
            {
                <p class="addr-comment">@address.Comment</p>
            }
            <div class="addr-actions">
                <a class="addr-btn" asp-page="AddressEdit" asp-route-id="@address.Id">@Icons.Get("pencil", 16) Изменить</a>
                <form asp-page-handler="Delete" asp-route-id="@address.Id" method="post" data-confirm="Удалить этот адрес?">
                    <button class="addr-btn addr-del" type="submit">@Icons.Get("trash", 16) Удалить</button>
                </form>
            </div>
        </article>
    }
    <a class="addr-add" href="/accounts/profile/addresses/add">
        <span class="addr-add-ico">@Icons.Get("plus", 22)</span>
        <b>Добавить адрес</b>
        <small>@(Model.Addresses.Count == 0 ? "Сохраните адрес, и он будет подставляться при заказе" : "Например, рабочий или адрес родителей")</small>
    </a>
</div>
</div>
</div>
