@page "/accounts/reset-password"
@model ResetPasswordModel
@{
    ViewData["Title"] = "Новый пароль";
}
<div class="panel form-narrow" style="margin:34px auto;">
    <h1>Новый пароль</h1>
    <form method="post" style="margin-top:18px;">
        <div class="form-row">
            <label asp-for="Input.Email"></label>
            <input class="field" asp-for="Input.Email" type="email" autocomplete="email">
            <span class="errorlist" asp-validation-for="Input.Email"></span>
        </div>
        <div class="form-row">
            <label asp-for="Input.Code"></label>
            <input class="field code-field" asp-for="Input.Code" inputmode="numeric" autocomplete="one-time-code" maxlength="8" autofocus>
            <span class="help">Код действует @OnlineShop.Web.Services.Email.MailTemplates.CodeLifetime. <a asp-page="ForgotPassword">Запросить новый код</a></span>
            <span class="errorlist" asp-validation-for="Input.Code"></span>
        </div>
        <div class="form-row">
            <label asp-for="Input.Password"></label>
            <input class="field" asp-for="Input.Password" autocomplete="new-password">
            <span class="help">Не короче 8 символов, не только цифры и не похож на логин.</span>
            <span class="errorlist" asp-validation-for="Input.Password"></span>
        </div>
        <div class="form-row">
            <label asp-for="Input.ConfirmPassword"></label>
            <input class="field" asp-for="Input.ConfirmPassword" autocomplete="new-password">
            <span class="errorlist" asp-validation-for="Input.ConfirmPassword"></span>
        </div>
        <button class="btn btn-block" type="submit">Сменить пароль</button>
    </form>
</div>
