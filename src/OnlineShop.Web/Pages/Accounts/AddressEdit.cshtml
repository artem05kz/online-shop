@page "/accounts/profile/addresses/{id:int}"
@model AddressEditModel
@{
    var heading = Model.IsNew ? "Новый адрес доставки" : "Изменить адрес";
    ViewData["Title"] = Model.IsNew ? "Новый адрес" : "Изменить адрес";
    ViewData["AccountTab"] = "addresses";
}
<div class="acc">
<partial name="_AccountTabs" />
<div class="acc-main">

<h1 class="acc-title">@heading</h1>
<p class="acc-lead">Поставьте метку на карте, и улица с домом подставятся сами. Остальное допишите справа.</p>
@*
    Слева карта (она остаётся на месте при прокрутке), справа все поля формы, чтобы их было видно сразу.
    Скрипт карты находит поля по id вида id_city, как в Django-версии, поэтому они заданы явно.
*@
<form method="post" class="ae">
    <div class="ae-map co-card">
        <div id="map" data-map-picker data-provider="@(Model.MapKey.Length > 0 ? "twogis" : "osm")" data-key="@Model.MapKey"
             data-lat="id_latitude" data-lng="id_longitude" data-city="id_city" data-street="id_street" data-house="id_house"></div>
        <p class="map-hint" id="map-hint">Метка не поставлена.</p>
        <span class="errorlist" asp-validation-for="Input.Latitude"></span>
        <input type="hidden" asp-for="Input.Latitude" id="id_latitude">
        <input type="hidden" asp-for="Input.Longitude" id="id_longitude">
    </div>

    <div class="ae-fields">
        <section class="co-card ae-card">
            <h2>Адрес</h2>
            <div class="ae-row ae-row-main">
                <div class="form-row">
                    <label for="id_city">Город</label>
                    <input class="field" asp-for="Input.City" id="id_city">
                    <span class="errorlist" asp-validation-for="Input.City"></span>
                </div>
                <div class="form-row">
                    <label for="id_street">Улица / микрорайон</label>
                    <input class="field" asp-for="Input.Street" id="id_street" placeholder="Улица или микрорайон">
                    <span class="errorlist" asp-validation-for="Input.Street"></span>
                </div>
                <div class="form-row">
                    <label for="id_house">Дом</label>
                    <input class="field" asp-for="Input.House" id="id_house">
                    <span class="errorlist" asp-validation-for="Input.House"></span>
                </div>
            </div>
            <div class="ae-row ae-row-small">
                <div class="form-row">
                    <label asp-for="Input.Apartment"></label>
                    <input class="field" asp-for="Input.Apartment">
                    <span class="errorlist" asp-validation-for="Input.Apartment"></span>
                </div>
                <div class="form-row">
                    <label asp-for="Input.Entrance"></label>
                    <input class="field" asp-for="Input.Entrance">
                    <span class="errorlist" asp-validation-for="Input.Entrance"></span>
                </div>
                <div class="form-row">
                    <label asp-for="Input.Floor"></label>
                    <input class="field" asp-for="Input.Floor">
                    <span class="errorlist" asp-validation-for="Input.Floor"></span>
                </div>
                <div class="form-row">
                    <label asp-for="Input.Intercom"></label>
                    <input class="field" asp-for="Input.Intercom">
                    <span class="errorlist" asp-validation-for="Input.Intercom"></span>
                </div>
            </div>
            <div class="form-row">
                <label asp-for="Input.Comment"></label>
                <textarea class="field" asp-for="Input.Comment" rows="2" placeholder="Например: позвонить за 10 минут"></textarea>
            </div>
        </section>

        <section class="co-card ae-card">
            <h2>Получатель</h2>
            <div class="ae-row ae-row-two">
                <div class="form-row">
                    <label asp-for="Input.FullName"></label>
                    <input class="field" asp-for="Input.FullName" autocomplete="name">
                    <span class="errorlist" asp-validation-for="Input.FullName"></span>
                </div>
                <div class="form-row">
                    <label asp-for="Input.Phone"></label>
                    <input class="field" asp-for="Input.Phone" type="tel" placeholder="+7 (___) ___-__-__" autocomplete="tel">
                    <span class="errorlist" asp-validation-for="Input.Phone"></span>
                </div>
            </div>
            <div class="form-row">
                <label asp-for="Input.Label"></label>
                <input class="field" asp-for="Input.Label" placeholder="Дом, Работа">
                <span class="help">Чтобы отличать адреса друг от друга.</span>
                <span class="errorlist" asp-validation-for="Input.Label"></span>
            </div>
            <label class="check ae-default">
                <input asp-for="Input.IsDefault">
                <span>Подставлять этот адрес при заказе</span>
            </label>
        </section>

        <div class="ae-actions">
            <button class="btn" type="submit">Сохранить адрес</button>
            <a class="st-btn" asp-page="Addresses">Отмена</a>
        </div>
    </div>
</form>
</div>
</div>

@section Scripts {
    <partial name="_MapScripts" model="Model.MapKey" />
}
