@page "/accounts/profile"
@model ProfileModel
@{
    ViewData["Title"] = "Личные данные";
    ViewData["AccountTab"] = "profile";
}
<h1>Личный кабинет</h1>
<partial name="_AccountTabs" />

<div class="panel form-narrow">
    <h3>Личные данные</h3>
    <p class="muted" style="font-size:.88rem;">Имя и фамилию заполнять необязательно, они только подставляются в заказ.</p>
    <form method="post" style="margin-top:16px;">
        <div class="form-row">
            <label for="login">Логин</label>
            <input class="field" id="login" type="text" value="@Model.UserName" disabled>
            <span class="help">Логин изменить нельзя.</span>
        </div>
        <div class="form-row">
            <label asp-for="Input.FirstName"></label>
            <input class="field" asp-for="Input.FirstName" placeholder="Необязательно" autocomplete="given-name">
            <span class="errorlist" asp-validation-for="Input.FirstName"></span>
        </div>
        <div class="form-row">
            <label asp-for="Input.LastName"></label>
            <input class="field" asp-for="Input.LastName" placeholder="Необязательно" autocomplete="family-name">
            <span class="errorlist" asp-validation-for="Input.LastName"></span>
        </div>
        <div class="form-row">
            <label for="email">Электронная почта</label>
            <input class="field" id="email" type="text" value="@(Model.Email ?? "не указана")" disabled>
            <span class="help">
                @if (Model.Email is null) { <text>Нужна для заказов.</text> }
                else if (!Model.EmailConfirmed) { <text>Не подтверждена.</text> }
                else { <text>Подтверждена.</text> }
                <a href="@EmailModel.PageUrl" style="color:var(--green-dark); font-weight:600;">@(Model.Email is null ? "Указать" : Model.EmailConfirmed ? "Сменить" : "Подтвердить")</a>
            </span>
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">Сохранить</button>
        </div>
    </form>
</div>
