@page "/accounts/email"
@model EmailModel
@{
    ViewData["Title"] = "Электронная почта";
    ViewData["AccountTab"] = "profile";
}
<div class="auth">
<div class="auth-card auth-narrow">
    <h1>Электронная почта</h1>
    <p class="auth-lead">На почту приходят статусы заказов и код, если забудете пароль.</p>

    @if (Model.CurrentEmail is not null && Model.IsConfirmed)
    {
        <p class="email-state ok">@Icons.Get("check", 18) <b>@Model.CurrentEmail</b> подтверждена</p>
    }
    else if (Model.CurrentEmail is not null)
    {
        <p class="email-state">Отправили код на <b>@Model.CurrentEmail</b>. Введите его ниже.</p>
        <form method="post" asp-page-handler="Confirm" asp-route-returnUrl="@Model.ReturnUrl">
            <div class="form-row">
                <label asp-for="Code"></label>
                <input class="field code-field" asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="8" autofocus>
                <span class="errorlist" asp-validation-for="Code"></span>
            </div>
            <button class="btn btn-block auth-submit" type="submit">Подтвердить</button>
        </form>
        <form method="post" asp-page-handler="Resend" asp-route-returnUrl="@Model.ReturnUrl" style="margin-top:10px;">
            <button class="btn btn-ghost btn-block" type="submit">Письмо не пришло, отправить код ещё раз</button>
        </form>
    }

    <form method="post" asp-page-handler="Send" asp-route-returnUrl="@Model.ReturnUrl" style="margin-top:24px;">
        <div class="form-row">
            <label asp-for="NewEmail">@(Model.CurrentEmail is null ? "Электронная почта" : "Другая почта")</label>
            <input class="field" asp-for="NewEmail" type="email" autocomplete="email" placeholder="name@mail.ru">
            <span class="errorlist" asp-validation-for="NewEmail"></span>
        </div>
        <button class="btn @(Model.CurrentEmail is null ? "" : "btn-ghost") btn-block" type="submit">
            @(Model.CurrentEmail is null ? "Получить код" : "Сменить почту")
        </button>
    </form>
</div>
</div>
