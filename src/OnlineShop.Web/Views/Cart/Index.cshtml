@model CartContents
@{
    ViewData["Title"] = "Корзина";
}
@*
    Корзина (компьютерная версия): слева товары (8 колонок из 12), справа итог (4 колонки), он едет за прокруткой.
    Сверху шаги покупки. Количество меняется кнопками − и +, форма отправляется сама (forms.js, data-autosubmit).
*@
@if (Model.IsEmpty)
{
    @* Пустая корзина (24.11, правка пользователя): одна белая карточка по центру страницы, без чёрной шапки. *@
    <section class="co-card search-empty cart-empty">
        <span class="search-empty-ico">@Icons.Get("cart", 26)</span>
        <div>
            <h1>Корзина пуста</h1>
            <p>Здесь пока ничего нет. Загляните в разделы на главной — там всё, что есть в наличии. Или найдите товар по названию и артикулу в строке поиска.</p>
            <div class="search-empty-actions">
                <a class="btn" asp-controller="Catalog" asp-action="Home">Перейти к товарам</a>
                <a class="btn btn-ghost" href="/favorites">@Icons.Get("heart", 18) Избранное</a>
            </div>
        </div>
    </section>
}
else
{
    <partial name="_CheckoutSteps" model="1" />
    <div class="co-head">
        <h1>Корзина</h1>
        <span class="co-count">@Model.Count @Plural.Choose(Model.Count, "товар", "товара", "товаров")</span>
    </div>

    <div class="co">
        <div class="co-main">
            <ul class="cart-list">
                @foreach (var line in Model.Lines)
                {
                    var product = line.Variant.Product;
                    var url = Url.Product(product);
                    var pack = string.IsNullOrEmpty(line.Variant.PackLabel) ? null : line.Variant.PackLabel;
                    <li class="cart-line">
                        <a class="cart-thumb" href="@url">
                            <img src="@Media.PhotoUrl(product, Media.Small)" alt="">
                        </a>
                        <div class="cart-info">
                            <a class="cart-name" href="@url">@product.Name</a>
                            <p class="cart-meta">@(pack is null ? "" : $"{pack} · ")арт. @line.Variant.Article</p>
                            <p class="cart-price">@Format.Money(line.Price) за шт.</p>
                            @if (line.Quantity > line.Variant.AvailableQty)
                            {
                                <p class="li-warn">@(line.Variant.AvailableQty == 0 ? "Закончился, уберите из корзины." : $"В наличии только {line.Variant.AvailableQty} шт., уменьшите количество.")</p>
                            }
                            else
                            {
                                <p class="cart-stock">В наличии: @line.Variant.AvailableQty шт.</p>
                            }
                        </div>
                        <form class="cart-qty" asp-action="Update" asp-route-variantId="@line.Variant.Id" method="post" data-autosubmit>
                            <span class="qty">
                                <button type="button" data-qty="minus" aria-label="Меньше">−</button>
                                <input type="number" name="quantity" value="@line.Quantity" min="1" max="@Math.Max(1, line.Variant.AvailableQty)" aria-label="Количество">
                                <button type="button" data-qty="plus" aria-label="Больше">+</button>
                            </span>
                            @* Запасной вариант, если в браузере отключены скрипты. *@
                            <noscript><button class="btn btn-ghost btn-sm" type="submit">Применить</button></noscript>
                        </form>
                        <strong class="cart-sum">@Format.Money(line.Subtotal)</strong>
                        <form class="cart-remove" asp-action="Remove" asp-route-variantId="@line.Variant.Id" method="post">
                            <button type="submit" aria-label="Убрать «@product.Name» из корзины" title="Убрать">@Icons.Get("trash", 18)</button>
                        </form>
                    </li>
                }
            </ul>
            <a class="co-back" asp-controller="Catalog" asp-action="Home">@Icons.Get("arrow-left", 16) Продолжить покупки</a>
        </div>

        <aside class="co-side">
            <div class="co-card">
                <h2>Итого</h2>
                <div class="summary-row"><span>Товары, @Model.Count шт.</span><span>@Format.Money(Model.Total)</span></div>
                @{
                    // Доставка по Актау: минимум 7 000 ₸. Меньше — доплата до 7 000 ₸, от 7 000 ₸ — бесплатно (DeliveryPrices).
                    var fee = DeliveryPrices.CityFee(Model.Total);
                    var progress = (int)Math.Min(100m, Model.Total / DeliveryPrices.CityMinimum * 100m);
                }
                <div class="summary-row"><span>Доставка по Актау</span><span>@(fee == 0 ? "бесплатно" : Format.Money(fee))</span></div>
                <div class="summary-row total"><span>К оплате</span><span>@Format.Money(Model.Total + fee)</span></div>
                @if (fee > 0)
                {
                    <div class="free-ship">
                        <div class="free-ship-bar" aria-hidden="true"><i style="width:@(progress)%"></i></div>
                        <p>Минимальный заказ с доставкой — @DeliveryPrices.CityMinimumText. Добавьте товаров ещё на <b>@Format.Money(fee)</b>: доставка станет бесплатной, а сумма к оплате не изменится.</p>
                    </div>
                }
                else
                {
                    <p class="free-ship is-free">@Icons.Get("check", 16) Доставка по Актау бесплатная</p>
                }
                <p class="summary-hint">При самовывозе — @Format.Money(Model.Total), без доставки.</p>
                <a class="btn co-cta" asp-controller="Checkout" asp-action="Index">Перейти к оформлению</a>
                <ul class="co-notes">
                    <li>@Icons.Get("check", 16) Оплата наличными или картой при получении</li>
                    <li>@Icons.Get("phone", 16) Менеджер позвонит и подтвердит заказ</li>
                    <li>@Icons.Get("truck", 16) По области доставка @DeliveryPrices.Region, точную сумму назовёт менеджер</li>
                </ul>
            </div>
        </aside>
    </div>
}
