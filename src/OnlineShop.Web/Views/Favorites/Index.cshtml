@model List<Product>
@*
    Избранное — в той же схеме, что раздел и поиск: чёрная шапка (крошки, заголовок, сколько товаров),
    ниже ровная сетка карточек. Гостю в шапке подсказка: избранное живёт в этом браузере, войдите — будет везде.
    Пусто — карточка с сердцем и кнопкой в каталог.
*@
@{
    ViewData["Title"] = "Избранное";
    var signedIn = User.Identity?.IsAuthenticated ?? false;
}
<header class="cat-hero search-hero" style="--cat-color:#0f0f0f">
    <nav class="cat-crumbs" aria-label="Вы здесь">
        <a asp-controller="Catalog" asp-action="Home">Главная</a>
        <span aria-hidden="true">/</span>
        <span>Избранное</span>
    </nav>
    <h1>Избранное</h1>
    <p class="cat-count">@(Model.Count == 0 ? "Пока ничего не отмечено" : $"{Model.Count} {Plural.Products(Model.Count)}")</p>
    @if (Model.Count > 0 && !signedIn)
    {
        <p class="fav-note">@Icons.Get("heart", 16)<span>Избранное сохранено в этом браузере. <a href="@ShopUrls.Login?ReturnUrl=/favorites">Войдите</a>, чтобы оно было видно и с телефона, и с компьютера, а о поступлении товаров, которых сейчас нет, приходило письмо.</span></p>
    }
</header>

@if (Model.Count == 0)
{
    <section class="co-card search-empty">
        <span class="search-empty-ico">@Icons.Get("heart", 26)</span>
        <div>
            <h2>Здесь пока пусто</h2>
            <p>Нажмите на сердечко у товара, и он появится на этой странице. Удобно, чтобы не искать заново.</p>
            <div class="search-empty-actions">
                <a class="btn" asp-controller="Catalog" asp-action="Home">Перейти в каталог</a>
            </div>
        </div>
    </section>
}
else
{
    <div class="product-grid">
        @foreach (var product in Model)
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>
}
