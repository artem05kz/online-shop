@model HomeViewModel
@inject OnlineShop.Web.Services.MediaStorage MediaStorage

@if (Model.Hero.Count + Model.Banners.Count > 0)
{
    <partial name="_Hero" model="Model" />
}

@* Крупные разделы, как на grass.su: цветные плитки, название сверху, картинка снизу (картинки — позже, рендеры).
   Какие категории каталога входят в раздел — Infrastructure/HomeSections.cs. Ссылка ведёт на самую большую из них:
   на странице категории сверху есть кнопки остальных. *@
<section class="section hs-section">
    <div class="section-head"><h2>Разделы</h2></div>
    <div class="hs">
        @foreach (var hs in HomeSections.All)
        {
            var inside = Model.Tiles.Where(t => HomeSections.Contains(hs, t.Category.Name)).ToList();
            var count = inside.Sum(t => t.ProductCount);
            var target = inside.OrderByDescending(t => t.ProductCount).FirstOrDefault();
            var image = hs.Image is null ? null : Url.Content($"~/img/sections/{hs.Image}");
            if (target is not null)
            {
                <a class="hs-tile" style="--hs-bg: @hs.Color" href="@Url.Category(target.Category)">
                    <span class="hs-name">@hs.Title</span>
                    <span class="hs-count">@count @Plural.Products(count)</span>
                    @if (image is not null) { <img class="hs-img" src="@image" alt="" loading="lazy"> }
                </a>
            }
            else
            {
                <div class="hs-tile is-soon" style="--hs-bg: @hs.Color">
                    <span class="hs-name">@hs.Title</span>
                    <span class="hs-count">Скоро в каталоге</span>
                    @if (image is not null) { <img class="hs-img" src="@image" alt="" loading="lazy"> }
                </div>
            }
        }
    </div>
</section>

@if (Model.Hits.Count > 0)
{
    <section class="section">
        <div class="section-head"><h2>Хиты продаж</h2></div>
        <div class="product-grid">
            @foreach (var product in Model.Hits)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>
}

@if (Model.Featured.Count > 0)
{
    <section class="section">
        <div class="section-head"><h2>Есть в наличии</h2></div>
        <div class="product-grid">
            @foreach (var product in Model.Featured)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>
}

@* Запись на мойку: после товаров в наличии, перед «Почему удобно заказывать у нас». *@
<partial name="_WashInvite" />

@if (Model.Tiles.Count > 0)
{
    <partial name="_Benefits" />
}

@if (Model.Stores.Count > 0)
{
    <partial name="_Visit" model="Model.Stores" />
}

@if (Model.Tiles.Count == 0)
{
    <section class="co-card search-empty">
        <span class="search-empty-ico">@Icons.Get("package", 26)</span>
        <div>
            <h2>Каталог пока пуст</h2>
            <p>Товары появятся после загрузки из 1С в панели управления.</p>
        </div>
    </section>
}

@section Scripts {
    @if (Model.Hero.Count + Model.Banners.Count > 0)
    {
        <script src="~/js/hero.js" asp-append-version="true"></script>
    }
}
