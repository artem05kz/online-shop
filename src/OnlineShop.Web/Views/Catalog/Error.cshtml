@model int
@{
    ViewData["Title"] = "Ошибка";
}
<div class="empty">
    <div class="empty-ico">@Icons.Get("alert", 44)</div>
    @if (Model == 403)
    {
        <h2>Нет доступа</h2>
        <p>Эта страница открывается только после входа под нужным аккаунтом.</p>
    }
    else if (Model == 429)
    {
        <h2>Слишком много попыток</h2>
        <p>Подождите минуту и попробуйте снова.</p>
    }
    else if (Model == 400)
    {
        <h2>Не получилось отправить форму</h2>
        <p>Скорее всего, страница была открыта слишком долго. Обновите её и попробуйте ещё раз.</p>
    }
    else
    {
        <h2>Что-то пошло не так</h2>
        <p>Попробуйте ещё раз через минуту. Если не получится, позвоните нам, и мы примем заказ по телефону.</p>
    }
    <p style="margin-top:18px;"><a class="btn" asp-controller="Catalog" asp-action="Home">На главную</a></p>
</div>
