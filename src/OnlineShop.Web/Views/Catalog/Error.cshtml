@model int
@{
    ViewData["Title"] = "Ошибка";
    var (title, text) = Model switch
    {
        403 => ("Нет доступа", "Эта страница открывается только после входа под нужным аккаунтом."),
        429 => ("Слишком много попыток", "Подождите минуту и попробуйте снова."),
        400 => ("Не получилось отправить форму", "Скорее всего, страница была открыта слишком долго. Обновите её и попробуйте ещё раз."),
        _ => ("Что-то пошло не так", "Попробуйте ещё раз через минуту. Если не получится, позвоните нам, и мы примем заказ по телефону."),
    };
    var card = (Code: Model, Title: title, Text: text, Search: false);
}
<partial name="_ErrorCard" model="card" />
