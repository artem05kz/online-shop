@model ProductListViewModel
@{
    var category = Model.Category!;
    ViewData["Title"] = category.Name;
}
<nav class="breadcrumbs">
    <a asp-action="Home">Главная</a>
    <span class="sep">/</span>
    <span>@category.Brand.Name</span>
    <span class="sep">/</span>
    <span>@category.Name</span>
</nav>

<h1>@Typo.Text(category.Name)</h1>

<partial name="_CategoryNav" model="Model" />

<partial name="_ProductList" model="Model" />
