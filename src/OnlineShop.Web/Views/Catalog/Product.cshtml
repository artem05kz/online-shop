@model ProductPageViewModel
@inject Favorites Favorites
@{
    var product = Model.Product;
    var brand = product.Category.Brand;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    ViewData["Title"] = product.Name;
    ViewData["Description"] = product.Description.Length > 150
        ? $"{product.Name}. {product.Description[..147]}..."
        : $"{product.Name}. {product.Description}";

    var images = product.Images.OrderByDescending(i => i.IsPrimary).ThenBy(i => i.SortOrder).ThenBy(i => i.Id).ToList();
    var packs = product.ActiveVariants;
    // Заранее выбрана фасовка, которую кладёт в корзину кнопка на карточке: самая дешёвая из тех, что есть.
    var chosen = product.DefaultVariant;
    var canBuy = chosen is { InStock: true };
}
@section Head {
    @{
        var siteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
        var productUrl = siteUrl + Url.Product(product);
        var ogImage = product.PrimaryImage is { } primary ? siteUrl + Media.Thumb(primary.ImagePath, Media.Large) : null;
    }
    @* Один адрес у страницы товара для поисковиков, даже если её открыли с параметрами. *@
    <link rel="canonical" href="@productUrl">
    @* Превью ссылки в WhatsApp, Telegram и соцсетях: название, фото и описание товара. *@
    <meta property="og:type" content="product">
    <meta property="og:title" content="@product.Name">
    <meta property="og:description" content="@ViewData["Description"]">
    <meta property="og:url" content="@productUrl">
    @if (ogImage is not null)
    {
        <meta property="og:image" content="@ogImage">
    }
    @Html.Raw(ProductMarkup.ScriptTag(product, productUrl, siteUrl, Model.Reviews))
}
<nav class="breadcrumbs">
    <a asp-action="Home">Главная</a>
    <span class="sep">/</span>
    <a href="@Url.Category(product.Category)">@product.Category.Name</a>
</nav>

@{
    // Цена за 1 кг / 1 л у каждой фасовки. «Выгоднее» — самая низкая цена за единицу среди фасовок в наличии
    // с той же единицей, если сравнивать есть с чем (хотя бы две такие фасовки).
    var perUnit = packs.ToDictionary(v => v.Id, v => PackSize.PerUnit(v.PackLabel, v.Price));
    var bestId = packs.Where(v => v.InStock && perUnit[v.Id] is not null)
        .GroupBy(v => perUnit[v.Id]!.Value.Unit)
        .Where(g => g.Count() > 1)
        .Select(g => g.MinBy(v => perUnit[v.Id]!.Value.Value)!.Id)
        .ToHashSet();
    string UnitText(int id) => perUnit[id] is { } u ? $"{Format.Money(u.Value)} за 1 {u.Unit}" : "";
    var text = ProductText.Split(product.Description);
}
@* Компьютерная версия: 12 колонок, две равные половины. Фото — колонки 1–6 и остаётся на месте при прокрутке, покупка — 7–12. *@
<div class="pp">
    <div class="pp-gallery">
        <div class="pp-photo">
            <img id="gallery-main" src="@Media.PhotoUrl(product, Media.Large)" alt="@product.Name">
        </div>
        @if (images.Count > 1)
        {
            <div class="gallery-thumbs">
                @foreach (var image in images)
                {
                    <button type="button" class="gallery-thumb@(image == images[0] ? " active" : "")" data-src="@Media.Thumb(image.ImagePath, Media.Large)" aria-label="Другое фото">
                        <img src="@Media.Thumb(image.ImagePath, Media.Small)" alt="">
                    </button>
                }
            </div>
        }
    </div>

    <div class="pp-info">
        <div class="pp-top">
            <a class="pp-cat" href="@Url.Category(product.Category)">@brand.Name · @CategoryNames.Short(product.Category.Name)</a>
            @if (HitProducts.IsHit(product))
            {
                <span class="badge-hit pp-hit">@Icons.Get("star", 13) Хит продаж</span>
            }
        </div>
        <h1 class="pp-h1">@Typo.Text(product.Name)</h1>
        @* Артикул и отзывы слева, «В избранное» справа — одной строкой, с воздухом между ними. *@
        <div class="pp-meta">
            <p class="pp-meta-info">
                @if (chosen is not null || packs.Count > 0)
                {
                    <span>арт. <span id="buy-article">@((chosen ?? packs[0]).Article)</span></span>
                }
                @if (Model.AverageRating is { } avg)
                {
                    <a href="#reviews"><span class="pp-stars">@Icons.Get("star", 14) @avg.ToString("0.0")</span> @Model.Reviews.Count @Plural.Choose(Model.Reviews.Count, "отзыв", "отзыва", "отзывов")</a>
                }
                else
                {
                    <a href="#reviews">Отзывов пока нет</a>
                }
            </p>
            <partial name="_FavoriteButton" model="new FavoriteButtonModel(product.Id, (await Favorites.IdsAsync()).Contains(product.Id), WithLabel: true)" />
        </div>

        @if (packs.Count == 0)
        {
            <p class="muted">Этого товара сейчас нет в продаже.</p>
        }
        else
        {
            <form asp-controller="Cart" asp-action="AddSelected" method="post" class="buy-box pp-buy" id="buy-box">
                <input type="hidden" name="next" value="@returnUrl">
                <p class="buy-label">@(packs.Count > 1 ? "Выберите фасовку" : "Фасовка")</p>
                <div class="pack-options">
                    @foreach (var pack in packs)
                    {
                        var available = pack.InStock && pack.Price is not null;
                        <label class="pack-option@(available ? "" : " is-off")">
                            <input type="radio" name="variantId" value="@pack.Id" checked="@(pack == chosen)" disabled="@(!available)"
                                   data-price="@(pack.Price is { } p ? Format.Money(p) : "")" data-unit="@UnitText(pack.Id)"
                                   data-available="@pack.AvailableQty" data-article="@pack.Article">
                            @if (bestId.Contains(pack.Id))
                            {
                                <span class="pack-best">Выгоднее</span>
                            }
                            <span class="pack-name">@(string.IsNullOrEmpty(pack.PackLabel) ? pack.Article : pack.PackLabel)</span>
                            <span class="pack-price">@(pack.Price is { } price ? Format.Money(price) : "цена уточняется")</span>
                            @if (packs.Count > 1 && perUnit[pack.Id] is not null)
                            {
                                <span class="pack-unit">@UnitText(pack.Id)</span>
                            }
                            <span class="pack-stock">@(pack.InStock ? $"в наличии {pack.AvailableQty} шт." : "нет в наличии")</span>
                        </label>
                    }
                </div>

                @if (canBuy)
                {
                    <div class="pp-total">
                        <div class="pp-price">
                            <span class="price" id="buy-price">@Format.Money(chosen!.Price!.Value)</span>
                            @if (packs.Count > 1)
                            {
                                <span class="pp-unit" id="buy-unit">@UnitText(chosen.Id)</span>
                            }
                        </div>
                        <span class="qty">
                            <button type="button" data-qty="minus" aria-label="Меньше">−</button>
                            <input type="number" name="quantity" value="1" min="1" max="@chosen!.AvailableQty" id="buy-qty" aria-label="Количество">
                            <button type="button" data-qty="plus" aria-label="Больше">+</button>
                        </span>
                    </div>
                    <button class="btn btn-block pp-cart" type="submit">@Icons.Get("cart", 20) В корзину</button>
                    <p class="buy-stock" id="buy-stock">В наличии: @chosen!.AvailableQty шт.</p>
                }
                else
                {
                    <p class="buy-note">@(chosen is null ? "Цена уточняется, позвоните в магазин." : "Сейчас нет в наличии. Добавьте товар в избранное, и мы напишем на почту, когда он появится.")</p>
                }
            </form>
        }

        <ul class="pp-perks">
            <li>@Icons.Get("truck", 20)<span><b>Доставка по Актау — @DeliveryPrices.City</b>Заказ меньше — доплата до @DeliveryPrices.CityMinimumText. По области — @DeliveryPrices.Region</span></li>
            <li>@Icons.Get("check", 20)<span><b>Оплата при получении</b>Наличными или картой</span></li>
            <li>@Icons.Get("star", 20)<span><b>Оригинальная продукция</b>Официальный дилер @brand.Name</span></li>
        </ul>
    </div>
</div>

@* Описание (колонки 1–6) и характеристики (7–12) — ровно под фото и покупкой. *@
<div class="pp-details">
    <section class="pp-desc" aria-labelledby="desc-title">
        <h2 id="desc-title">Описание</h2>
        @if (text.Intro.Length > 0)
        {
            <div class="prose">@text.Intro</div>
        }
        @if (text.Steps.Count > 0)
        {
            <h3 class="pp-howto">Способ применения</h3>
            <ol class="pp-steps">
                @foreach (var step in text.Steps)
                {
                    <li>@Typo.Text(step)</li>
                }
            </ol>
        }
        @if (text.Outro.Length > 0)
        {
            <div class="prose">@text.Outro</div>
        }
        @if (text.Intro.Length == 0 && text.Steps.Count == 0)
        {
            <p class="muted">Описание скоро появится. Подробности подскажет менеджер.</p>
        }
    </section>
    <aside class="pp-specs" aria-labelledby="specs-title">
        <h2 id="specs-title">Характеристики</h2>
        <ul class="spec-list">
            <li><span>Бренд</span><span>@brand.Name</span></li>
            <li><span>Раздел</span><span><a href="@Url.Category(product.Category)">@product.Category.Name</a></span></li>
            @if (!string.IsNullOrEmpty(product.Ph))
            {
                <li><span>Кислотность</span><span>@product.Ph</span></li>
            }
            @if (packs.Count > 0)
            {
                <li><span>Фасовки</span><span>@string.Join(", ", packs.Select(v => v.PackLabel).Where(l => !string.IsNullOrEmpty(l)))</span></li>
                <li><span>Артикулы</span><span>@string.Join(", ", packs.Select(v => v.Article))</span></li>
            }
        </ul>
    </aside>
</div>

<section class="section reviews pr" id="reviews">
    @{
        var mine = Model.MyReview;
        var justSent = TempData["ReviewSent"] is true;
        string[] ratingWords = ["", "Плохо", "Так себе", "Нормально", "Хорошо", "Отлично"];
    }
    <div class="pr-list">
        <div class="section-head">
            <h2>Отзывы</h2>
            @if (Model.AverageRating is { } average)
            {
                <span class="rating-sum"><partial name="_Stars" model="(int)Math.Round(average)" /> @average.ToString("0.0") из 5, @Model.Reviews.Count @Plural.Choose(Model.Reviews.Count, "отзыв", "отзыва", "отзывов")</span>
            }
        </div>
        @if (Model.Reviews.Count == 0)
        {
            <p class="muted">Отзывов пока нет.</p>
        }
        @foreach (var review in Model.Reviews)
        {
            <article class="review">
                <div class="review-head">
                    <partial name="_Stars" model="review.Rating" />
                    <b>@(review.User.FirstName.Length > 0 ? review.User.FirstName : "Покупатель")</b>
                    <span class="muted">@Format.ToLocal(review.CreatedAt).ToString("dd.MM.yyyy")</span>
                </div>
                @if (review.Text.Length > 0)
                {
                    <p class="review-text">@review.Text</p>
                }
            </article>
        }
        @if (!Model.CanReview && !(User.Identity?.IsAuthenticated ?? false))
        {
            <p class="muted pr-login">Купили этот товар? <a href="@ShopUrls.Login?ReturnUrl=@Uri.EscapeDataString(Context.Request.Path + "#reviews")">Войдите</a>, чтобы оставить отзыв.</p>
        }
    </div>

    @if (Model.CanReview)
    {
        <aside class="pr-side">
            @* Отзыв уже есть: сначала карточка о его судьбе, форма спрятана под «Изменить отзыв». *@
            @if (mine is not null)
            {
                var (title, note) = mine.Status switch
                {
                    ReviewStatus.Approved => ("Ваш отзыв опубликован", "Спасибо! Его видят другие покупатели."),
                    ReviewStatus.Rejected => ("Отзыв не прошёл проверку", "Можно исправить текст и отправить снова."),
                    _ => (justSent ? "Отзыв отправлен" : "Отзыв на проверке",
                          "Менеджер проверит его, и он появится на этой странице."),
                };
                <div class="pr-status @(justSent ? "is-new" : "")" role="@(justSent ? "status" : null)">
                    <span class="pr-status-ico">@Icons.Get(mine.Status == ReviewStatus.Rejected ? "clock" : "check", 22)</span>
                    <div>
                        <h3>@title</h3>
                        <p>@note</p>
                    </div>
                    <div class="pr-status-mine">
                        <partial name="_Stars" model="mine.Rating" />
                        @if (mine.Text.Length > 0)
                        {
                            <p class="review-text">@mine.Text</p>
                        }
                    </div>
                </div>
            }

            @if (mine is not null)
            {
                @:<details class="pr-edit">
                @:<summary class="btn btn-outline">Изменить отзыв</summary>
            }
            @* asp-controller и asp-action, а не action="...": только так форма получает защитный токен. *@
            <form class="review-form pr-form" method="post" asp-controller="Reviews" asp-action="Save" asp-route-productId="@product.Id">
                <h3>@(mine is null ? "Ваш отзыв" : "Изменить ваш отзыв")</h3>
                <fieldset class="star-input">
                    <legend>Ваша оценка</legend>
                    <div class="star-row">
                        @for (var star = 5; star >= 1; star--)
                        {
                            <input type="radio" id="star-@star" name="rating" value="@star" checked="@(mine?.Rating == star)" required>
                            <label for="star-@star" title="@ratingWords[star]" data-word="@ratingWords[star]">@Icons.Get("star", 34)<span class="visually-hidden">@star из 5</span></label>
                        }
                    </div>
                    <span class="star-word" aria-hidden="true"></span>
                </fieldset>
                <label class="visually-hidden" for="review-text">Текст отзыва</label>
                <div class="pr-text">
                    <textarea id="review-text" name="text" rows="5" maxlength="@Review.MaxTextLength"
                              placeholder="Как средство показало себя в деле? Что понравилось, а что нет">@mine?.Text</textarea>
                    <span class="pr-count" data-for="review-text"><span>@(mine?.Text.Length ?? 0)</span> / @Review.MaxTextLength</span>
                </div>
                <button class="btn pr-send" type="submit">Отправить отзыв</button>
                <p class="pr-hint">Отзыв появится на сайте после проверки менеджером.</p>
            </form>
            @if (mine is not null)
            {
                @:</details>
            }
        </aside>
    }
</section>

@if (Model.Related.Count > 0)
{
    <section class="section">
        <div class="section-head"><h2>Похожие товары</h2></div>
        <div class="product-grid">
            @foreach (var related in Model.Related)
            {
                <partial name="_ProductCard" model="related" />
            }
        </div>
    </section>
}

@if (Model.BoughtWith.Count > 0)
{
    @* С этим покупают (24.11): из тех же заказов, а пока заказов мало — хиты других разделов. *@
    <section class="section">
        <div class="section-head"><h2>С этим покупают</h2></div>
        <div class="product-grid">
            @foreach (var item in Model.BoughtWith)
            {
                <partial name="_ProductCard" model="item" />
            }
        </div>
    </section>
}

@if (Model.Recent.Count > 0)
{
    <section class="section">
        <div class="section-head"><h2>Вы недавно смотрели</h2></div>
        <div class="product-grid">
            @foreach (var item in Model.Recent)
            {
                <partial name="_ProductCard" model="item" />
            }
        </div>
    </section>
}

@section Scripts {
    <script nonce="@Context.CspNonce()">
    (function () {
        // Цена у кнопки «В корзину» показывает выбранную фасовку.
        // При выборе фасовки меняются цена, артикул, остаток и наибольшее количество.
        var price = document.getElementById('buy-price');
        var unit = document.getElementById('buy-unit');
        var article = document.getElementById('buy-article');
        var stock = document.getElementById('buy-stock');
        var qty = document.getElementById('buy-qty');
        document.querySelectorAll('#buy-box input[name=variantId]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                if (price && radio.getAttribute('data-price')) price.textContent = radio.getAttribute('data-price');
                if (article) article.textContent = radio.getAttribute('data-article');
                if (unit) unit.textContent = radio.getAttribute('data-unit') || '';
                var available = parseInt(radio.getAttribute('data-available'), 10);
                if (stock) stock.textContent = 'В наличии: ' + available + ' шт.';
                if (qty) {
                    qty.max = available;
                    if (parseInt(qty.value, 10) > available) qty.value = available;
                }
            });
        });
        // Миниатюры фото меняют большое фото.
        var main = document.getElementById('gallery-main');
        document.querySelectorAll('.gallery-thumb').forEach(function (thumb) {
            thumb.addEventListener('click', function () {
                main.src = thumb.getAttribute('data-src');
                document.querySelectorAll('.gallery-thumb').forEach(function (t) { t.classList.remove('active'); });
                thumb.classList.add('active');
            });
        });
        // Счётчик символов под текстом отзыва.
        document.querySelectorAll('.pr-count').forEach(function (count) {
            var area = document.getElementById(count.getAttribute('data-for'));
            var num = count.querySelector('span');
            area.addEventListener('input', function () { num.textContent = area.value.length; });
        });
        // Только что отправленный отзыв: карточку «Отзыв отправлен» показываем на экране.
        var sent = document.querySelector('.pr-status.is-new');
        if (sent) { sent.scrollIntoView({ block: 'center' }); }
    })();
    </script>
}
