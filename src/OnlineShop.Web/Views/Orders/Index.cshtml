@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "История заказов";
    ViewData["AccountTab"] = "orders";
    const int PreviewItems = 4;
}
@*
    Мои заказы: карточка на заказ — номер, дата, статус, полоса прогресса, фото товаров, сумма,
    «Подробнее» и «Повторить заказ». Новые сверху.
*@
<div class="acc">
<partial name="_AccountTabs" />
<div class="acc-main">
<h1 class="acc-title">Мои заказы</h1>

@if (Model.Count == 0)
{
    <div class="co-card acc-empty">
        <span class="acc-empty-ico">@Icons.Get("package", 30)</span>
        <h2>Заказов пока нет</h2>
        <p>Здесь появятся ваши заказы и их статусы.</p>
        <a class="btn" asp-controller="Catalog" asp-action="Home">Перейти к товарам</a>
    </div>
}

@foreach (var order in Model)
{
    var items = order.Items.OrderBy(i => i.Id).ToList();
    <article class="co-card oh-card">
        <div class="order-head">
            <div>
                <a class="o-num" asp-action="Detail" asp-route-id="@order.Id">Заказ №@order.Id</a>
                <div class="o-date">@Format.DateTimeText(order.CreatedAt) · @(order.IsPickup ? "самовывоз" : "доставка")</div>
            </div>
            <span class="status status-@order.Status.ToCode()">@order.StatusText(order.Status)</span>
        </div>
        @if (order.ProgressSteps.Count > 0)
        {
            <div class="tracker">
                @foreach (var step in order.ProgressSteps)
                {
                    <div class="tracker-step@(step.IsDone ? " done" : "")@(step.IsCurrent ? " current" : "")">
                        <div class="tracker-bar"></div>
                        <div class="tracker-label">@step.Label</div>
                    </div>
                }
            </div>
        }
        <div class="oh-body">
            <ul class="oh-thumbs">
                @foreach (var item in items.Take(PreviewItems))
                {
                    <li title="@item.ProductName@(string.IsNullOrEmpty(item.PackLabel) ? "" : ", " + item.PackLabel) — @item.Quantity шт.">
                        <img src="@Media.PhotoUrl(item.Variant.Product, Media.Small)" alt="">
                        @if (item.Quantity > 1)
                        {
                            <span>×@item.Quantity</span>
                        }
                    </li>
                }
                @if (items.Count > PreviewItems)
                {
                    <li class="oh-more" title="и ещё @(items.Count - PreviewItems) поз.">+@(items.Count - PreviewItems)</li>
                }
            </ul>
            <div class="oh-total">
                <span>@order.TotalQuantity шт.</span>
                <strong>@Format.Money(order.Total)</strong>
            </div>
        </div>
        <div class="oh-actions">
            <a class="st-btn" asp-action="Detail" asp-route-id="@order.Id">Подробнее о заказе</a>
            <form asp-action="Repeat" asp-route-id="@order.Id" method="post">
                <button class="btn oh-repeat" type="submit">@Icons.Get("refresh", 16) Повторить заказ</button>
            </form>
        </div>
    </article>
}
</div>
</div>
