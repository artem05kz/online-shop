# Caddy принимает запросы снаружи и передаёт их сайту. Если в SITE_ADDRESS указан домен (shop.kz),
# Caddy сам получает и продлевает сертификат HTTPS. Без домена (:80) работает по обычному HTTP.
{$SITE_ADDRESS}

encode zstd gzip

# Фото с телефона до 20 МБ, несколько за раз, баннер до 25 МБ: с запасом.
request_body {
	max_size 110MB
}

reverse_proxy app:8080
