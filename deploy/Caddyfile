# Caddy принимает запросы снаружи и передаёт их сайту. Если в SITE_ADDRESS указан домен (shop.kz),
# Caddy сам получает и продлевает сертификат HTTPS. Без домена (:80) работает по обычному HTTP.
{$SITE_ADDRESS}

encode zstd gzip

header {
	# Браузер запоминает на год: этот сайт открывать только по HTTPS, даже если набрали http://.
	# По обычному HTTP браузеры этот заголовок не учитывают, поэтому без домена он ничего не ломает.
	Strict-Transport-Security "max-age=31536000"
	# Не сообщать, на чём работает сервер.
	-Server
}

# Фото с телефона до 20 МБ, несколько за раз, баннер до 25 МБ: с запасом.
request_body {
	max_size 110MB
}

reverse_proxy app:8080
